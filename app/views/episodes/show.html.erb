<div class="flex justify-between text-sm mb-4">
  <div>
    <% if previous_episode = Episode.find_by(id: episode.id - 1) %>
      <%= link_to "<- #{previous_episode.title}", previous_episode %>
    <% end %>
  </div>

  <div>
    <% if next_episode = Episode.find_by(id: episode.id + 1) %>
      <%= link_to "#{next_episode.title} ->", next_episode %>
    <% end %>
  </div>
</div>

<h2 class="text-center text-2xl mb-6"><%= episode.title %></h2>

<div class="overflow-hidden bg-gray-900 shadow sm:rounded-lg text-gray-300 border border-gray-600">
  <div class="px-4 py-5 sm:px-8">
    <h3 class="text-base font-semibold leading-6 text-gray-300">Episode Details</h3>
  </div>
  <div class="border-t border-gray-600 px-4 py-5 sm:p-0">
    <dl class="sm:divide-y sm:divide-gray-600">
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Title</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0"><%= episode.title %></dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Publish Date</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0"><%= episode.publish_at.strftime("%b %d, %Y") %></dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Episode Link</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0"><%= link_to "https://radiolab.org/episodes/#{episode.slug}", "https://radiolab.org/episodes/#{episode.slug}" %></dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Audio Source</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0">
          <div class="flex items-center">
            <audio controls class="mr-4">
              <source src="<%= episode.audio_url %>" type="audio/mpeg">
              Your browser does not support the audio tag.
            </audio>

            (<%= link_to "link", episode.audio_url %>)
          </div>
        </dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Tease</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0"><%== episode.tease %></dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Image</dt>
        <dd class="mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0">
          <%= image_tag episode.image_url %>
        </dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Duration</dt>
        <dd class="overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0">
          <%= seconds_to_description(episode.length) %>
        </dd>
      </div>
      <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5 sm:px-8">
        <dt class="text-sm font-medium">Full Description</dt>
        <dd class="inlined-description overflow-scroll mt-1 text-sm text-gray-300 sm:col-span-2 sm:mt-0"><%== episode.cut_description %></dd>
      </div>
    </dl>
  </div>
</div>
