<div data-controller="search">
  <div class="flex items-center justify-between gap-4">
    <input type="search"
      placeholder="Search episodes..."
      autocomplete="off"
      data-search-target="input"
      data-action="input->search#filter keydown->search#clear"
      class="bg-gray-800 text-white placeholder-gray-400 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white w-full max-w-sm">

    <% if current_user %>
      <%= form_with method: :get do |f| %>
        <%= select_tag :filter,
          options_for_select([["All", "all"], ["Listened", "listened"], ["Unlistened", "unlistened"]], @filter),
          class: "bg-gray-800 text-white rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white w-32",
          onchange: "this.form.submit();"
        %>
      <% end %>
    <% end %>
  </div>

  <%= render "episode_table" %>

  <p data-search-target="empty" class="hidden mt-8 text-center text-sm text-gray-400">No episodes match your search.</p>
</div>
