<tr id="episode-row-<%= episode.id %>">
  <td class="pl-4 pr-3 text-sm font-medium text-white sm:pl-0 w-[250px]">
    <%= link_to episode.title, episode_path(episode), class: "block py-4" %>
  </td>
  <td class="py-4 px-3 text-sm text-gray-300"><%= episode.publish_at.strftime("%x") %></td>
  <td class="py-4 px-3 text-sm text-gray-300"><%== episode.tease %></td>

  <% if current_user %>
    <td class="py-4 px-2">
      <div class="flex items-center justify-around h-full">
        <% eu ||= @user_episodes.detect{ |eu| eu.episode_id == episode.id } %>

        <%= link_to listen_path(episode), data: { "turbo-method": :post } do %>
          <%= heroicon (eu&.listened? ? "eye" : "eye-slash"), options: { class: "w-4 h-4" }, variant: (eu&.listened? ? "solid" : "outline") %>
        <% end %>

        <%= link_to favorite_path(episode), data: { "turbo-method": :post } do %>
          <%= heroicon "star", options: { class: "w-4 h-4" }, variant: (eu&.favorite? ? "solid" : "outline") %>
        <% end %>
      </div>
    </td>
  <% end %>
</tr>
