<!DOCTYPE html>
<html>
  <head>
    <title>Radiolab Archive</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#001d37] text-gray-200">
    <main class="container mx-auto mt-16 px-5 max-w-[900px]">
      <h1 class="text-center text-3xl font-bold mb-12 text-gray">
        <%= link_to "Radiolab Archive", root_path, class: "text-gray-200" %>
      </h1>

      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>

      <%= yield %>
    </main>
  </body>
</html>
